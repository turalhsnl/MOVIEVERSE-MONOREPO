generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  createdAt     DateTime @default(now())

  profile Profile?
  actions MovieAction[]
}

model Profile {
  id          String  @id @default(cuid())
  userId      String  @unique
  displayName String?
  avatarUrl   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MovieAction {
  id        String   @id @default(cuid())
  userId    String
  movieId   Int
  type      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId, type])
  @@index([userId, type])
}