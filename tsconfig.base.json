{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@movie/types": ["packages/types/src/index.ts"],
      "@movie/tmdb": ["packages/tmdb/src/index.ts"],
      "@movie/design": ["packages/design/src/index.ts"],
      "@movie/api-client": ["packages/api-client/src/index.ts"]
    }
  }
}
